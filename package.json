{
  "name": "consultorio-local",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "npm run build && node backend/src/server.js --demo --open",
    "dev:ui": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node backend/src/server.js --open",
    "test": "node --test",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "package:macos": "python scripts/package-macos.py"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.3.0"
  }
}
